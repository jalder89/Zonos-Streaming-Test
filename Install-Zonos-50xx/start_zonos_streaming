echo "Starting Zonos Streaming Service for HerikaServer..."
cd /home/dwemer/Zonos
source ./bin/activate

# Install additional dependencies if needed (suppress output to avoid clutter)
pip install fastapi uvicorn > /dev/null 2>&1

echo "Starting streaming service on port 8765..."
echo "Service will be available at: http://localhost:8765"
echo "Model: transformer (RTX 50xx compatible)"
echo "Press Ctrl+C to stop"
echo ""

# Use the existing gradio interface but in API mode for streaming
# This leverages the existing working Zonos installation
python3 -c "
import uvicorn
from fastapi import FastAPI
import torch
from zonos.model import Zonos
from zonos.conditioning import make_cond_dict
from fastapi.responses import StreamingResponse
from pydantic import BaseModel
import torchaudio
import tempfile
from typing import Optional, List
import logging

# Set up logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

app = FastAPI(title='Zonos Streaming for HerikaServer')

# Global model
model = None

class TTSRequest(BaseModel):
    text: str
    speaker_voice: Optional[str] = None
    language: str = 'en-us'
    streaming: bool = True
    character_name: Optional[str] = None

@app.on_event('startup')
async def startup():
    global model
    logger.info('Loading Zonos transformer model...')
    model = Zonos.from_pretrained('Zyphra/Zonos-v0.1-transformer', device='cuda' if torch.cuda.is_available() else 'cpu')
    model.requires_grad_(False).eval()
    logger.info('Model loaded successfully!')

@app.get('/status')
async def status():
    return {'status': 'running', 'model': 'transformer', 'device': str(model.device) if model else 'loading'}

@app.post('/tts/single')
async def tts_single(request: TTSRequest):
    if model is None:
        return {'error': 'Model not loaded'}
    
    try:
        # Use default speaker for now
        speaker = torch.zeros(1, 256, device=model.device)
        
        cond_dict = make_cond_dict(text=request.text, speaker=speaker, language=request.language)
        conditioning = model.prepare_conditioning(cond_dict)
        
        if request.streaming:
            def generate_stream():
                stream_gen = model.stream(
                    prefix_conditioning=conditioning,
                    chunk_schedule=[16, 9, 12, 15, 20, 30],
                    chunk_overlap=2,
                    cfg_scale=2.0,
                    max_new_tokens=2580
                )
                for chunk in stream_gen:
                    if isinstance(chunk, torch.Tensor):
                        yield chunk.cpu().numpy().tobytes()
            
            return StreamingResponse(
                generate_stream(),
                media_type='application/octet-stream',
                headers={'X-Sample-Rate': str(model.autoencoder.sampling_rate)}
            )
        else:
            codes = model.generate(conditioning, max_new_tokens=2580, cfg_scale=2.0)
            audio = model.autoencoder.decode(codes)[0]
            
            with tempfile.NamedTemporaryFile(suffix='.wav', delete=False) as tmp:
                torchaudio.save(tmp.name, audio.cpu(), model.autoencoder.sampling_rate)
                return {'audio_file': tmp.name, 'sample_rate': model.autoencoder.sampling_rate}
    
    except Exception as e:
        logger.error(f'TTS failed: {e}')
        return {'error': str(e)}

if __name__ == '__main__':
    uvicorn.run(app, host='0.0.0.0', port=8765)
"