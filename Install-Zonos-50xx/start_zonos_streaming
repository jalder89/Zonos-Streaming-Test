#!/bin/bash

echo "Starting Zonos Streaming Service for HerikaServer..."
cd /home/dwemer/Zonos
source ./bin/activate

# Copy the streaming service to the Zonos directory if it doesn't exist
if [ ! -f "zonos_streaming_service.py" ]; then
    echo "Copying HerikaServer streaming service..."
    # The service should be copied from the HerikaServer directory
    if [ -f "/mnt/c/path/to/HerikaServer/zonos_streaming_service.py" ]; then
        cp "/mnt/c/path/to/HerikaServer/zonos_streaming_service.py" .
    else
        echo "Warning: zonos_streaming_service.py not found. Please copy it manually."
        echo "From Windows: copy the file from HerikaServer-Streaming-Test\\zonos_streaming_service.py"
        echo "To WSL: /home/dwemer/Zonos/zonos_streaming_service.py"
    fi
fi

# Install additional dependencies for the streaming service
pip install fastapi uvicorn

# Start the streaming service (transformer model recommended for RTX 50xx compatibility)
python3 zonos_streaming_service.py \
    --host 0.0.0.0 \
    --port 8765 \
    --model transformer \
    --device cuda